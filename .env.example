# Server Configuration (Render sets $PORT automatically — do not override PORT)
HOST=0.0.0.0

# ─── CORS Configuration ──────────────────────────────────────────────────────
# Add your Vercel frontend URL here (no trailing slash)
# Multiple origins are comma-separated
FRONTEND_ORIGIN=https://YOUR_VERCEL_APP.vercel.app,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5500

# ─── Database Configuration ───────────────────────────────────────────────────
# Local development: relative SQLite
DATABASE_URL=sqlite:///./road_damage.db
# Render production (persistent disk mounted at /data):
# DATABASE_URL=sqlite:////data/road_damage.db

# ─── Upload Storage ───────────────────────────────────────────────────────────
# Where uploaded / annotated images are stored.
# Local development: omit or leave default (backend/uploads/)
#   UPLOADS_DIR=
# Render production: point at the persistent disk so images survive deploys
#   UPLOADS_DIR=/data/uploads
UPLOADS_DIR=


# ─── Optional API Protection ──────────────────────────────────────────────────
# If set, mutating endpoints (POST/PATCH/DELETE) require header: X-API-Key: <value>
# Leave EMPTY for local development (writes are unrestricted).
# Set a strong, secret value in the Render dashboard to protect production writes.
API_KEY=

