# Server Configuration (Render sets $PORT automatically — do not override PORT)
HOST=0.0.0.0

# ─── CORS Configuration ──────────────────────────────────────────────────────
# Add your Vercel frontend URL here (no trailing slash)
# Multiple origins are comma-separated
FRONTEND_ORIGIN=https://YOUR_VERCEL_APP.vercel.app,http://localhost:8000,http://127.0.0.1:8000,http://localhost:3000,http://127.0.0.1:5500

# ─── Database Configuration ───────────────────────────────────────────────────
# Local development: relative SQLite
DATABASE_URL=sqlite:///./road_damage.db
# Render production (persistent disk mounted at /data):
# DATABASE_URL=sqlite:////data/road_damage.db

# ─── AI Detection Configuration ───────────────────────────────────────────────
# Leave empty to run in "no model" mode (no fake detections generated)
MODEL_PATH=
CONFIDENCE_THRESHOLD=0.5
